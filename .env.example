# 이 파일을 .env 로 복사한 뒤 실제 키를 채워주세요. (.env 는 절대 커밋 금지)

# --- Claude API (필수) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-8          # 사진/판단은 opus, 대량 1차 스크리닝은 haiku 권장
ANTHROPIC_SCREENING_MODEL=claude-haiku-4-5-20251001

# --- 네이버 검색/지역 API (1단계 수집, 필수) ---
# https://developers.naver.com/apps  에서 발급
NAVER_CLIENT_ID=xxxxxxxx
NAVER_CLIENT_SECRET=xxxxxxxx

# --- 통계청 KOSIS API (수요예측, 필수) ---
# 국가통계포털 월별 출생아 수(인구동향조사) 수집.  https://kosis.kr/openapi
KOSIS_API_KEY=xxxxxxxx

# --- 구글시트 출력 (선택) ---
# 서비스 계정 JSON 경로. 비워두면 엑셀(.xlsx)로만 출력.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# --- 동작 옵션 ---
REQUEST_DELAY_SECONDS=1.0     # 수집 시 요청 간 최소 지연 (예의/차단 방지)
MAX_PLACES_PER_QUERY=100
