# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# 환경변수 / 비밀키
.env
*.local
credentials.json
token.json
service_account*.json

# 데이터 (수집 결과는 커밋하지 않음)
data/raw/*
data/processed/*
data/output/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/output/.gitkeep
*.xlsx
*.csv
*.sqlite
*.db
# 단, 목업/예시 입력 데이터는 추적 (MVP 실행에 필요)
!data/sample_candidates.csv
!data/jade_actuals.example.csv
!data/venue_capacity.example.csv
# 샘플 결과물(폰 GitHub 앱 미리보기용)은 추적
!data/output/sample/
!data/output/sample/*.csv
!data/output/sample/*.xlsx
!data/output/sample/*.md

# 캐시
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / 에디터
.DS_Store
.idea/
.vscode/
